    "## 8. Performance and Load Testing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Performance testing\n",
    "def performance_test(num_requests=5):\n",
    "    \"\"\"Test API performance with multiple concurrent requests\"\"\"\n",
    "    print(f\"Running Performance Test ({num_requests} requests)...\")\n",
    "    print(\"=\" * 50)\n",
    "    \n",
    "    response_times = []\n",
    "    success_count = 0\n",
    "    \n",
    "    for i in range(num_requests):\n",
    "        print(f\"Request {i+1}/{num_requests}...\", end=\" \")\n",
    "        \n",
    "        # Generate random test data\n",
    "        test_state = np.random.choice(['relaxed', 'focused', 'stressed'])\n",
    "        test_data = generate_sample_eeg_data(test_state)\n",
    "        \n",
    "        # Measure response time\n",
    "        start_time = time.time()\n",
    "        success, result = test_eeg_analysis(test_data)\n",
    "        end_time = time.time()\n",
    "        \n",
    "        response_time = end_time - start_time\n",
    "        response_times.append(response_time)\n",
    "        \n",
    "        if success:\n",
    "            success_count += 1\n",
    "            print(f\"✓ {response_time:.3f}s\")\n",
    "        else:\n",
    "            print(f\"❌ {response_time:.3f}s - {result}\")\n",
    "        \n",
    "        # Small delay between requests\n",
    "        time.sleep(0.1)\n",
    "    \n",
    "    # Calculate statistics\n",
    "    if response_times:\n",
    "        avg_time = np.mean(response_times)\n",
    "        min_time = np.min(response_times)\n",
    "        max_time = np.max(response_times)\n",
    "        std_time = np.std(response_times)\n",
    "        success_rate = success_count / num_requests * 100\n",
    "        \n",
    "        print(f\"\\nPerformance Results:\")\n",
    "        print(f\"  Success Rate: {success_rate:.1f}% ({success_count}/{num_requests})\")\n",
    "        print(f\"  Average Response Time: {avg_time:.3f}s\")\n",
    "        print(f\"  Min Response Time: {min_time:.3f}s\")\n",
    "        print(f\"  Max Response Time: {max_time:.3f}s\")\n",
    "        print(f\"  Std Deviation: {std_time:.3f}s\")\n",
    "        print(f\"  Requests per Second: {1/avg_time:.2f}\")\n",
    "        \n",
    "        # Visualize performance\n",
    "        plt.figure(figsize=(12, 4))\n",
    "        \n",
    "        plt.subplot(1, 2, 1)\n",
    "        plt.plot(range(1, len(response_times)+1), response_times, 'o-', alpha=0.7)\n",
    "        plt.axhline(y=avg_time, color='r', linestyle='--', alpha=0.7, label=f'Average: {avg_time:.3f}s')\n",
    "        plt.title('Response Time per Request', fontweight='bold')\n",
    "        plt.xlabel('Request Number')\n",
    "        plt.ylabel('Response Time (s)')\n",
    "        plt.legend()\n",
    "        plt.grid(True, alpha=0.3)\n",
    "        \n",
    "        plt.subplot(1, 2, 2)\n",
    "        plt.hist(response_times, bins=max(3, num_requests//3), alpha=0.7, edgecolor='black')\n",
    "        plt.axvline(x=avg_time, color='r', linestyle='--', alpha=0.7, label=f'Average: {avg_time:.3f}s')\n",
    "        plt.title('Response Time Distribution', fontweight='bold')\n",
    "        plt.xlabel('Response Time (s)')\n",
    "        plt.ylabel('Frequency')\n",
    "        plt.legend()\n",
    "        plt.grid(True, alpha=0.3)\n",
    "        \n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "        return {\n",
    "            'success_rate': success_rate,\n",
    "            'avg_response_time': avg_time,\n",
    "            'min_response_time': min_time,\n",
    "            'max_response_time': max_time,\n",
    "            'requests_per_second': 1/avg_time\n",
    "        }\n",
    "    else:\n",
    "        print(\"No valid response times recorded\")\n",
    "        return None\n",
    "\n",
    "# Run performance test\n",
    "perf_results = performance_test(num_requests=10)\n",
    "\n",
    "if perf_results:\n",
    "    print(\"\\n✓ Performance testing complete\")\nelse:\n",
    "    print(\"\\n❌ Performance testing failed\")"
   ]
  },
