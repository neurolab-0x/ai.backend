   "source": [
    "# Test voice processing endpoints\n",
    "def generate_synthetic_audio_bytes(emotion='neutral', duration=2.0, sample_rate=16000):\n",
    "    \"\"\"Generate synthetic audio data as bytes for API testing\"\"\"\n",
    "    t = np.linspace(0, duration, int(sample_rate * duration))\n",
    "    \n",
    "    if emotion == 'angry':\n",
    "        # High frequency, irregular pattern\n",
    "        audio = 0.3 * np.sin(2 * np.pi * 800 * t) + 0.2 * np.sin(2 * np.pi * 1200 * t)\n",
    "        audio += 0.1 * np.random.normal(0, 1, len(t))\n",
    "    elif emotion == 'sad':\n",
    "        # Low frequency, slow pattern\n",
    "        audio = 0.4 * np.sin(2 * np.pi * 200 * t) + 0.2 * np.sin(2 * np.pi * 300 * t)\n",
    "        audio *= np.exp(-t * 0.5)\n",
    "    elif emotion == 'happy':\n",
    "        # Mid-high frequency, rhythmic pattern\n",
    "        audio = 0.3 * np.sin(2 * np.pi * 440 * t) + 0.2 * np.sin(2 * np.pi * 660 * t)\n",
    "        audio *= (1 + 0.3 * np.sin(2 * np.pi * 5 * t))\n",
    "    else:  # neutral\n",
    "        # Balanced frequency content\n",
    "        audio = 0.2 * np.sin(2 * np.pi * 440 * t) + 0.1 * np.sin(2 * np.pi * 880 * t)\n",
    "    \n",
    "    # Normalize and convert to int16\n",
    "    audio = audio / np.max(np.abs(audio))\n",
    "    audio_int16 = (audio * 32767).astype(np.int16)\n",
    "    \n",
    "    return audio_int16.tobytes()\n",
    "\n",
    "def test_voice_analysis(audio_bytes, emotion_type):\n",
    "    \"\"\"Test voice analysis endpoint\"\"\"\n",
    "    try:\n",
    "        # Create a file-like object\n",
    "        files = {\n",
    "            'file': ('test_audio.wav', audio_bytes, 'audio/wav')\n",
    "        }\n",
    "        \n",
    "        response = api_session.post(\n",
    "            f\"{API_BASE_URL}/voice/analyze\",\n",
    "            files=files,\n",
    "            timeout=API_TIMEOUT\n",
    "        )\n",
    "        \n",
    "        if response.status_code == 200:\n",
    "            return True, response.json()\n",
    "        else:\n",
    "            return False, f\"HTTP {response.status_code}: {response.text}\"\n",
    "    except requests.exceptions.RequestException as e:\n",
    "        return False, str(e)\n",
    "\n",
    "# Test voice processing\n",
    "print(\"Testing Voice Processing Endpoints...\")\n",
    "print(\"=\" * 40)\n",
    "\n",
    "voice_emotions = ['neutral', 'happy', 'sad', 'angry']\n",
    "voice_results = []\n",
    "\n",
    "for emotion in voice_emotions:\n",
    "    print(f\"\\nTesting {emotion} voice...\")\n",
    "    \n",
    "    # Generate synthetic audio\n",
    "    audio_bytes = generate_synthetic_audio_bytes(emotion)\n",
    "    print(f\"  Generated audio: {len(audio_bytes)} bytes\")\n",
    "    \n",
    "    # Test voice analysis\n",
    "    success, result = test_voice_analysis(audio_bytes, emotion)\n",
    "    \n",
    "    if success:\n",
    "        print(f\"  ✓ Voice analysis successful\")\n",
    "        \n",
    "        if 'data' in result:\n",
    "            data = result['data']\n",
    "            detected_emotion = data.get('emotion', 'unknown')\n",
    "            confidence = data.get('confidence', 0)\n",
    "            mental_state = data.get('mental_state', 'unknown')\n",
    "            \n",
    "            print(f\"  Detected emotion: {detected_emotion} (confidence: {confidence:.3f})\")\n",
    "            print(f\"  Mental state: {mental_state}\")\n",
    "            \n",
    "            voice_results.append({\n",
    "                'true_emotion': emotion,\n",
    "                'detected_emotion': detected_emotion,\n",
    "                'confidence': confidence,\n",
    "                'mental_state': mental_state\n",
    "            })\n",
    "    else:\n",
    "        print(f\"  ❌ Voice analysis failed: {result}\")\n",
    "\n",
    "print(f\"\\n✓ Completed {len(voice_results)} successful voice analyses\")"
   ]
