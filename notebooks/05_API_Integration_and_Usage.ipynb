    "            return False, f\"HTTP {response.status_code}: {response.text}\"\n",
    "    except requests.exceptions.RequestException as e:\n",
    "        return False, str(e)\n",
    "\n",
    "# Get API information\n",
    "info_ok, api_info = get_api_info()\n",
    "if info_ok:\n",
    "    print(\"NeuroLab API Information:\")\n",
    "    print(\"=\" * 40)\n",
    "    print(f\"Name: {api_info.get('name', 'Unknown')}\")\n",
