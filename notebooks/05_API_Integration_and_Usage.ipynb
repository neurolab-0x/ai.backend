    "# Generate sample EEG data for API testing\n",
    "def generate_sample_eeg_data(state='relaxed'):\n",
    "    \"\"\"Generate sample EEG data for API testing\"\"\"\n",
    "    np.random.seed(42)  # For reproducible results\n",
    "    \n",
    "    if state == 'relaxed':\n",
    "        # High alpha, low beta\n",
    "        alpha = np.random.uniform(20, 35)\n",
    "        beta = np.random.uniform(5, 15)\n",
    "        theta = np.random.uniform(8, 18)\n",
    "        delta = np.random.uniform(3, 10)\n",
    "        gamma = np.random.uniform(2, 8)\n",
    "    elif state == 'focused':\n",
    "        # High beta, moderate alpha\n",
    "        alpha = np.random.uniform(10, 25)\n",
    "        beta = np.random.uniform(20, 35)\n",
    "        theta = np.random.uniform(3, 10)\n",
    "        delta = np.random.uniform(2, 8)\n",
    "        gamma = np.random.uniform(8, 20)\n",
    "    else:  # stressed\n",
    "        # Very high beta, low alpha, elevated gamma\n",
    "        alpha = np.random.uniform(5, 15)\n",
    "        beta = np.random.uniform(30, 45)\n",
    "        theta = np.random.uniform(10, 20)\n",
    "        delta = np.random.uniform(5, 15)\n",
    "        gamma = np.random.uniform(15, 30)\n",
    "    \n",
    "    return {\n",
    "        'alpha': alpha,\n",
    "        'beta': beta,\n",
    "        'theta': theta,\n",
    "        'delta': delta,\n",
    "        'gamma': gamma,\n",
    "        'subject_id': 'test_subject',\n",
    "        'session_id': f'api_test_{int(time.time())}'\n",
    "    }\n",
    "\n",
    "# Test EEG analysis endpoint\n",
    "def test_eeg_analysis(eeg_data):\n",
    "    \"\"\"Test the EEG analysis endpoint\"\"\"\n",
    "    try:\n",
    "        response = api_session.post(\n",
    "            f\"{API_BASE_URL}/analyze\",\n",
    "            json=eeg_data,\n",
    "            timeout=API_TIMEOUT\n",
    "        )\n",
    "        \n",
    "        if response.status_code == 200:\n",
    "            return True, response.json()\n",
    "        else:\n",
    "            return False, f\"HTTP {response.status_code}: {response.text}\"\n",
    "    except requests.exceptions.RequestException as e:\n",
    "        return False, str(e)\n",
    "\n",
    "# Test different mental states\n",
    "states_to_test = ['relaxed', 'focused', 'stressed']\n",
    "analysis_results = []\n",
    "\n",
    "print(\"Testing EEG Analysis Endpoints...\")\n",
    "print(\"=\" * 40)\n",
    "\n",
    "for state in states_to_test:\n",
    "    print(f\"\\nTesting {state} state...\")\n",
    "    \n",
    "    # Generate sample data\n",
    "    sample_data = generate_sample_eeg_data(state)\n",
    "    print(f\"  Input data: α={sample_data['alpha']:.1f}, β={sample_data['beta']:.1f}, θ={sample_data['theta']:.1f}\")\n",
    "    \n",
    "    # Test analysis\n",
    "    success, result = test_eeg_analysis(sample_data)\n",
    "    \n",
    "    if success:\n",
    "        print(f\"  ✓ Analysis successful\")\n",
    "        \n",
    "        # Extract key results\n",
    "        if 'predictions' in result:\n",
    "            predictions = result['predictions']\n",
    "            predicted_state = predictions.get('predicted_state', 'unknown')\n",
    "            confidence = predictions.get('confidence', 0)\n",
    "            print(f\"  Predicted state: {predicted_state} (confidence: {confidence:.3f})\")\n",
    "        \n",
    "        if 'cognitive_metrics' in result:\n",
    "            metrics = result['cognitive_metrics']\n",
    "            attention = metrics.get('attention_index', 0)\n",
    "            relaxation = metrics.get('relaxation_index', 0)\n",
    "            stress = metrics.get('stress_index', 0)\n",
    "            print(f\"  Cognitive metrics: Attention={attention:.3f}, Relaxation={relaxation:.3f}, Stress={stress:.3f}\")\n",
    "        \n",
    "        analysis_results.append({\n",
    "            'true_state': state,\n",
    "            'result': result\n",
    "        })\n",
    "    else:\n",
    "        print(f\"  ❌ Analysis failed: {result}\")\n",
    "\n",
    "print(f\"\\n✓ Completed {len(analysis_results)} successful analyses\")"
   ]
