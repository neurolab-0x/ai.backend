  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. API Configuration and Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# API Configuration\n",
    "API_BASE_URL = \"http://localhost:8000\"\n",
    "API_TIMEOUT = 30\n",
    "\n",
    "# Create a session with retry strategy\n",
    "def create_api_session():\n",
    "    session = requests.Session()\n",
    "    \n",
    "    # Retry strategy\n",
    "    retry_strategy = Retry(\n",
    "        total=3,\n",
    "        backoff_factor=1,\n",
    "        status_forcelist=[429, 500, 502, 503, 504],\n",
    "    )\n",
    "    \n",
    "    adapter = HTTPAdapter(max_retries=retry_strategy)\n",
    "    session.mount(\"http://\", adapter)\n",
    "    session.mount(\"https://\", adapter)\n",
    "    \n",
    "    return session\n",
    "\n",
    "# Initialize API session\n",
    "api_session = create_api_session()\n",
    "\n",
    "print(f\"✓ API session configured\")\n",
    "print(f\"Base URL: {API_BASE_URL}\")\n",
    "print(f\"Timeout: {API_TIMEOUT}s\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. API Health Check and Status"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check API health and status\n",
    "def check_api_health():\n",
    "    \"\"\"Check if the API is running and healthy\"\"\"\n",
    "    try:\n",
    "        response = api_session.get(f\"{API_BASE_URL}/health\", timeout=API_TIMEOUT)\n",
    "        if response.status_code == 200:\n",
    "            health_data = response.json()\n",
    "            return True, health_data\n",
    "        else:\n",
    "            return False, f\"HTTP {response.status_code}: {response.text}\"\n",
    "    except requests.exceptions.RequestException as e:\n",
    "        return False, str(e)\n",
    "\n",
    "def check_auth_status():\n",
    "    \"\"\"Check authentication status\"\"\"\n",
    "    try:\n",
    "        response = api_session.get(f\"{API_BASE_URL}/auth-status\", timeout=API_TIMEOUT)\n",
    "        if response.status_code == 200:\n",
    "            return True, response.json()\n",
    "        else:\n",
    "            return False, f\"HTTP {response.status_code}: {response.text}\"\n",
    "    except requests.exceptions.RequestException as e:\n",
    "        return False, str(e)\n",
    "\n",
    "# Check API status\n",
    "print(\"Checking API Status...\")\n",
    "print(\"=\" * 30)\n",
    "\n",
    "# Health check\n",
    "health_ok, health_data = check_api_health()\n",
    "if health_ok:\n",
    "    print(\"✓ API is healthy\")\n",
    "    print(f\"  Status: {health_data.get('status', 'unknown')}\")\n",
    "    if 'authentication' in health_data:\n",
    "        auth_info = health_data['authentication']\n",
    "        print(f\"  Authentication: {auth_info.get('status', 'unknown')}\")\n",
    "    if 'diagnostics' in health_data:\n",
    "        diag = health_data['diagnostics']\n",
    "        print(f\"  Model loaded: {diag.get('model_loaded', 'unknown')}\")\n",
    "        print(f\"  TensorFlow available: {diag.get('tensorflow_available', 'unknown')}\")\nelse:\n",
    "    print(f\"❌ API health check failed: {health_data}\")\n",
    "\n",
    "# Authentication status\n",
    "auth_ok, auth_data = check_auth_status()\n",
    "if auth_ok:\n",
    "    print(f\"\\n✓ Authentication status: {auth_data.get('status', 'unknown')}\")\n",
    "    print(f\"  Enabled: {auth_data.get('authentication_enabled', 'unknown')}\")\nelse:\n",
    "    print(f\"\\n❌ Auth status check failed: {auth_data}\")"
   ]
  },
